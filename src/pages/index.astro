---
import Layout from '@/layouts/Layout.astro';
import ThreeCanvas from '@/components/ThreeCanvas.vue';
import Countdown from '@/components/Countdown.vue';
import HeartBorder from '@/components/HeartBorder.vue';
import '@/styles/global.css';
---

<Layout title="My Dedicated Website For You">
  <main class="relative min-h-screen w-full overflow-hidden flex flex-col items-center justify-center bg-gradient-to-b from-[#070612] via-[#0d0922] to-[#080614]">
    <!-- Frame Border Kiri & Kanan Berjalan -->
    <HeartBorder client:load />

    <!-- 2D Night Sky Background: Luminous Moon + Twinkling Stars + Glowing Hearts -->
    <ThreeCanvas client:load />

    <!-- Luxury Canvas Grain Texture Overlay (Light opacity untuk tema malam) -->
    <div
      class="pointer-events-none fixed inset-0 z-[5] opacity-[0.03] mix-blend-screen"
      style="background-image: url('data:image/svg+xml;utf8,<svg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'><filter id=\'noiseFilter\'><feTurbulence type=\'fractalNoise\' baseFrequency=\'0.8\' numOctaves=\'3\' stitchTiles=\'stitch\'/></filter><rect width=\'100%\' height=\'100%\' filter=\'url(%23noiseFilter)\'/></svg>');"
    ></div>

    <!-- Hiasan Pita Cantik di Bagian Atas Halaman (Pink Glowing Bow Divider) -->
    <header class="pointer-events-none fixed top-6 sm:top-10 z-10 flex flex-col items-center justify-center w-full px-2 sm:px-6">
      <img
        src="/ribbon-divider-pink.png"
        alt="Pink Bow Ribbon Divider"
        class="w-[96vw] max-w-[850px] h-auto drop-shadow-[0_0_14px_rgba(244,114,182,0.9)] select-none opacity-100"
      />
    </header>

    <!-- Central Glowing Countdown -->
    <Countdown client:load />
  </main>
</Layout>
