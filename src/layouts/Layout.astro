---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "My Dedicated Website For You",
  description = "A special place dedicated to my favorite person."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/lovemailicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-gradient-to-b from-rose-50/50 via-white to-pink-50/30 text-slate-800 antialiased selection:bg-rose-200 selection:text-rose-900 min-h-screen">
    <slot />

    <script>
      import { initSmoothScroll } from '@/lib/lenis';
      // Inisialisasi Lenis Smooth Scroll
      initSmoothScroll();
    </script>
  </body>
</html>
